# jev-antigravity-bridge — Environment Variables
# Copy this file to .env and fill in your real values.

# TypeSafe / Jev System-1 API key (get one at console.typesafe.ai/keys).
# JEV_API_KEY or TYPESAFE_API_KEY — either name works.
JEV_API_KEY=your_typesafe_api_key_here

# Optional overrides (defaults: https://api.typesafe.ai/v1 and jev-latest)
# JEV_API_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest

# Min confidence to auto-click (0–1)
JEV_CONFIDENCE_THRESHOLD=0.75

PLAYWRIGHT_BROWSER_TYPE=chromium

# chrome | msedge | chromium
PLAYWRIGHT_CHANNEL=chrome

# launch = Antigravity opens Chrome itself (recommended)
# attach = connect to an already-open debug browser
# auto   = try CDP then launch
JEV_BROWSER_MODE=launch

# Dedicated profile folder for launch mode
JEV_USER_DATA_DIR=C:\ChromeDebugJev

# Only needed for attach mode
JEV_CDP_URL=http://127.0.0.1:9222

PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_LAUNCH_TIMEOUT=45000
PLAYWRIGHT_ACTION_TIMEOUT=15000

# Where Playwright looks for bundled browsers (chromium channel / npm test).
# Leave unset for the default cache; set to keep browser binaries off C:.
# PLAYWRIGHT_BROWSERS_PATH=D:\tools\playwright-browsers

LOG_LEVEL=info
